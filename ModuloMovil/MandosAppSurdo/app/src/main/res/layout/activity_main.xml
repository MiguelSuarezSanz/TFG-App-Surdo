<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Conexión.MainActivity"
    android:background="@drawable/fondomain">

    <TextView
        android:id="@+id/textView"
        android:layout_width="335dp"
        android:layout_height="89dp"
        android:fontFamily="@font/kablammo"
        android:shadowColor="#56317E"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="20"
        android:text="App"
        android:textAlignment="center"
        android:textColor="#FF9800"
        android:textSize="60sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.211" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="335dp"
        android:layout_height="89dp"
        android:fontFamily="@font/kablammo"
        android:shadowColor="#56317E"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="20"
        android:text="Surdo"
        android:textAlignment="center"
        android:textColor="#ff5b9f"
        android:textSize="60sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.295" />

    <LinearLayout
        android:layout_width="322dp"
        android:layout_height="160dp"
        android:layout_marginBottom="88dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/mando1"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_margin="5dp"
            android:backgroundTint="#c490ff"
            android:text="Prueba Conexion"
            android:textSize="20sp"
            app:cornerRadius="200dp"
            app:strokeColor="#965DD5"
            app:strokeWidth="10sp" />

        <Button
            android:id="@+id/mando2"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_margin="5dp"
            android:backgroundTint="#c490ff"
            android:text="Prueba Minijuego"
            app:cornerRadius="200dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>