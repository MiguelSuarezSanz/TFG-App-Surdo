<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E2E">

    <!-- =====================================================
         PANTALLA 1: MENÚ PRINCIPAL
         Solo muestra el texto de espera y el botón local
    ===================================================== -->
    <LinearLayout
        android:id="@+id/pantallaMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/txtEsperandoServidor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳ Esperando respuesta del servidor..."
            android:textColor="#A0A0C0"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="48dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJugar"
            android:layout_width="220dp"
            android:layout_height="64dp"
            android:text="Jugar en local"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:backgroundTint="#6C63FF"
            app:cornerRadius="32dp"/>

    </LinearLayout>

    <!-- =====================================================
         PANTALLA 2: EXPLICACIÓN DEL MINIJUEGO
         Solo título del minijuego y botón de listo
    ===================================================== -->
    <LinearLayout
        android:id="@+id/pantallaExplicacion"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtTituloMinijuego"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="64dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnListo"
            android:layout_width="200dp"
            android:layout_height="64dp"
            android:text="¡Listo!"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:backgroundTint="#43A047"
            app:cornerRadius="32dp"/>

    </LinearLayout>

    <!-- =====================================================
         PANTALLA 3: JUEGO (todos los minijuegos aquí)
    ===================================================== -->
    <LinearLayout
        android:id="@+id/pantallaJuego"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <!-- Temporizador compartido -->
        <TextView
            android:id="@+id/txtTemporizador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FF5252"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- MINIJUEGO: BOTONES -->
        <LinearLayout
            android:id="@+id/contenedorBotones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn1"
                android:layout_width="225dp"
                android:layout_height="225dp"
                android:layout_margin="5dp"
                android:text=""
                android:textSize="20sp"
                android:textAllCaps="false"
                app:cornerRadius="500dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn2"
                android:layout_width="225dp"
                android:layout_height="225dp"
                android:layout_margin="5dp"
                android:text=""
                android:textSize="35sp"
                android:textAllCaps="false"
                app:cornerRadius="500dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn3"
                android:layout_width="225dp"
                android:layout_height="225dp"
                android:layout_margin="5dp"
                android:text=""
                android:textSize="35sp"
                android:textAllCaps="false"
                app:cornerRadius="500dp"/>

        </LinearLayout>

        <!-- MINIJUEGO: GIROSCOPIO -->
        <LinearLayout
            android:id="@+id/contenedorGiroscopio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imagen"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:visibility="invisible"
                app:srcCompat="@drawable/pistola"/>

            <TextView
                android:id="@+id/txtEstadoGiro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inclina el móvil..."
                android:textColor="#A0A0C0"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_marginTop="24dp"/>

        </LinearLayout>

        <!-- MINIJUEGO: SALUDO TRADICIONAL CATALAN -->
        <LinearLayout
            android:id="@+id/contenedorAcelerometro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/foto_cuchillo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:rotation="45"
                app:srcCompat="@drawable/cuchillo"/>

            <TextView
                android:id="@+id/txtEstadoAccel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Esperando movimiento..."
                android:textColor="#A0A0C0"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_marginTop="16dp"/>

        </LinearLayout>

        <!-- MINIJUEGO: PESCA -->
        <LinearLayout
            android:id="@+id/contenedorPesca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtEmojiPesca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎣"
                android:textSize="80sp"/>

            <TextView
                android:id="@+id/txtEstadoPesca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#D0D0E8"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_marginTop="20dp"/>

        </LinearLayout>

        <!-- MINIJUEGO: DIBUJAR FIGURAS -->
        <FrameLayout
            android:id="@+id/contenedorDibujo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="16dp"
                android:layout_gravity="top">

                <TextView
                    android:id="@+id/txtFiguraObjetivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dibuja: ○ Círculo"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/txtEstadoDibujo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Figura 1 de 3"
                    android:textColor="#A0A0C0"
                    android:textSize="15sp"
                    android:gravity="center"/>

            </LinearLayout>

            <TextView
                android:id="@+id/txtResultadoDibujo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_gravity="center"/>

        </FrameLayout>

        <!-- MINIJUEGO: UN SIMPLE BOTÓN -->
        <LinearLayout
            android:id="@+id/contenedorSimpleBoton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtInstruccionSimpleBoton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="40dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonSimple"
                android:layout_width="180dp"
                android:layout_height="180dp"
                app:cornerRadius="90dp"/>

        </LinearLayout>

        <!-- MINIJUEGO: DUELO A LA IRLANDESA -->
        <LinearLayout
            android:id="@+id/contenedorDueloIrlandes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <!-- Porcentaje restante -->
            <TextView
                android:id="@+id/txtPorcentajeCerveza"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍺 100%"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Vaso: contenedor gris que simula el vidrio -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="280dp"
                android:background="#33FFFFFF"
                android:layout_marginBottom="16dp">

                <!-- Bloque ámbar: es la cerveza, su altura se reduce por código -->
                <View
                    android:id="@+id/vistaLiquido"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_gravity="bottom"
                    android:background="#FFA000"/>

            </FrameLayout>

            <!-- Mensaje de estado -->
            <TextView
                android:id="@+id/txtEstadoCerveza"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Inclina el móvil y bebe!"
                android:textColor="#D0D0E8"
                android:textSize="17sp"
                android:gravity="center"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- =====================================================
         PANTALLA 4: GAME OVER
         Puntuación + comentario aleatorio de derrota
    ===================================================== -->
    <LinearLayout
        android:id="@+id/pantallaGameOver"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💀 GAME OVER"
            android:textColor="#FF5252"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/txtPuntuacionFinal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Puntuación: 0"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/txtComentarioDerrota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#A0A0C0"
            android:textSize="18sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volviendo al menú..."
            android:textColor="#505070"
            android:textSize="14sp"/>

    </LinearLayout>

</FrameLayout>