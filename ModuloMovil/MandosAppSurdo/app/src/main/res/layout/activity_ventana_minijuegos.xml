<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E2E">

    <!-- =========================================================
         PANTALLA 1: MENÚ PRINCIPAL
    ========================================================= -->
    <LinearLayout
        android:id="@+id/pantallaMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮 MINIJUEGOS"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/txtMaxPuntuacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Máxima puntuación: 0"
            android:textColor="#A0A0C0"
            android:textSize="18sp"
            android:layout_marginBottom="48dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJugar"
            android:layout_width="200dp"
            android:layout_height="64dp"
            android:text="¡JUGAR!"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:backgroundTint="#6C63FF"
            app:cornerRadius="32dp"/>

    </LinearLayout>

    <!-- =========================================================
         PANTALLA 2: EXPLICACIÓN DEL MINIJUEGO
    ========================================================= -->
    <LinearLayout
        android:id="@+id/pantallaExplicacion"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtTituloMinijuego"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minijuego"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/txtExplicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Explicación del minijuego aquí"
            android:textColor="#D0D0E8"
            android:textSize="18sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="48dp"/>

        <TextView
            android:id="@+id/txtPuntuacionActual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Puntuación: 0"
            android:textColor="#6C63FF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="48dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnListo"
            android:layout_width="200dp"
            android:layout_height="64dp"
            android:text="¡Listo!"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:backgroundTint="#43A047"
            app:cornerRadius="32dp"/>

    </LinearLayout>

    <!-- =========================================================
         PANTALLA 3: JUEGO (contiene todos los minijuegos)
    ========================================================= -->
    <LinearLayout
        android:id="@+id/pantallaJuego"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <!-- Temporizador visible en todos los minijuegos que lo usen -->
        <TextView
            android:id="@+id/txtTemporizador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FF5252"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- MINIJUEGO BOTONES (vertical: apilados) -->
        <LinearLayout
            android:id="@+id/contenedorBotones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn1"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="16dp"
                android:text=""
                android:textSize="22sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="20dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn2"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="16dp"
                android:text=""
                android:textSize="22sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="20dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn3"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:text=""
                android:textSize="22sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="20dp"/>

        </LinearLayout>

        <!-- MINIJUEGO GIROSCOPIO -->
        <LinearLayout
            android:id="@+id/contenedorGiroscopio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imagen"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:visibility="invisible"
                app:srcCompat="@drawable/pistola"/>

            <TextView
                android:id="@+id/txtEstadoGiro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inclina el móvil..."
                android:textColor="#A0A0C0"
                android:textSize="18sp"
                android:layout_marginTop="24dp"/>

        </LinearLayout>

        <!-- MINIJUEGO ACELERÓMETRO (sacudida / movimiento) -->
        <LinearLayout
            android:id="@+id/contenedorAcelerometro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtEmojiAccel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱"
                android:textSize="72sp"/>

            <TextView
                android:id="@+id/txtEstadoAccel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Esperando movimiento..."
                android:textColor="#A0A0C0"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_marginTop="16dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- =========================================================
         PANTALLA 4: GAME OVER
    ========================================================= -->
    <LinearLayout
        android:id="@+id/pantallaGameOver"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💀 GAME OVER"
            android:textColor="#FF5252"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/txtPuntuacionFinal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Puntuación: 0"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/txtMensajeRecord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFD700"
            android:textSize="20sp"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volviendo al menú..."
            android:textColor="#A0A0C0"
            android:textSize="16sp"/>

    </LinearLayout>

</FrameLayout>