<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#c490ff">

    <!-- =====================================================
         PANTALLA 1: MENÚ PRINCIPAL
         Solo muestra el texto de espera y el botón local
    ===================================================== -->
    <LinearLayout
        android:id="@+id/pantallaMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/txtEsperandoServidor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:gravity="center"
            android:text="Esperando respuesta del servidor..."
            android:textColor="#000000"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJugar"
            android:layout_width="220dp"
            android:layout_height="64dp"
            android:text="Jugar en local"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/tertiaryColor"
            app:cornerRadius="32dp"
            app:strokeColor="#fc7b09"
            app:strokeWidth="3dp"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- =====================================================
         PANTALLA 2: JUEGO (todos los minijuegos aquí)
    ===================================================== -->
    <LinearLayout
        android:id="@+id/pantallaJuego"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- MINIJUEGO: BOTONES -->
        <LinearLayout
            android:id="@+id/contenedorBotones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn1"
                android:layout_width="225dp"
                android:layout_height="225dp"
                android:layout_margin="5dp"
                android:text=""
                android:textAllCaps="false"
                android:textSize="20sp"
                app:cornerRadius="500dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn2"
                android:layout_width="225dp"
                android:layout_height="225dp"
                android:layout_margin="5dp"
                android:text=""
                android:textAllCaps="false"
                android:textSize="35sp"
                app:cornerRadius="500dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn3"
                android:layout_width="225dp"
                android:layout_height="225dp"
                android:layout_margin="5dp"
                android:text=""
                android:textAllCaps="false"
                android:textSize="35sp"
                app:cornerRadius="500dp" />

        </LinearLayout>

        <!-- MINIJUEGO: GIROSCOPIO -->
        <LinearLayout
            android:id="@+id/contenedorGiroscopio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imagen"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:visibility="visible"
                app:srcCompat="@drawable/pistola" />

            <TextView
                android:id="@+id/txtEstadoGiro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="PLACEHOLDER"
                android:textColor="#000000"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- MINIJUEGO: SALUDO TRADICIONAL CATALÁN -->
        <LinearLayout
            android:id="@+id/contenedorAcelerometro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/foto_cuchillo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:rotation="45"
                app:srcCompat="@drawable/cuchillo" />

            <TextView
                android:id="@+id/txtEstadoAccel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="PLACEHOLDER"
                android:textColor="#000000"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- MINIJUEGO: PESCA -->
        <LinearLayout
            android:id="@+id/contenedorPesca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtEmojiPesca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎣"
                android:textSize="80sp" />

            <TextView
                android:id="@+id/txtEstadoPesca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="PLACEHOLDER"
                android:textColor="#000000"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- MINIJUEGO: UN SIMPLE BOTÓN -->
        <LinearLayout
            android:id="@+id/contenedorSimpleBoton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtInstruccionSimpleBoton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:gravity="center"
                android:text="PLACEHOLDER"
                android:textColor="#000000"
                android:textSize="24sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonSimple"
                android:layout_width="180dp"
                android:layout_height="180dp"
                app:cornerRadius="90dp" />

        </LinearLayout>

        <!-- MINIJUEGO: DUELO A LA IRLANDESAn-->
        <LinearLayout
            android:id="@+id/contenedorDueloIrlandes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtPorcentajeCerveza"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="🍺 100%"
                android:textColor="#000000"
                android:textSize="28sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:background="#33000000">

                <!-- Bloque ámbar: la cerveza, su altura se reduce por código -->
                <View
                    android:id="@+id/vistaLiquido"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="bottom"
                    android:background="#FFA000" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- =====================================================
         PANTALLA 3: GAME OVER
         Puntuación + comentario aleatorio de derrota
    ===================================================== -->
    <LinearLayout
        android:id="@+id/pantallaGameOver"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tituloFinJuego"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="PLACEHOLDER"
            android:textColor="#FF5252"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPuntuacionFinal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Puntuación: 0"
            android:textColor="#000000"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtComentarioDerrota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text=""
            android:textColor="#000000"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volviendo al menú..."
            android:textColor="#000000"
            android:textSize="14sp" />

    </LinearLayout>

</FrameLayout>