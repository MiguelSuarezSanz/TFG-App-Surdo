<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#313131"
    android:orientation="vertical">

    <!-- ========================================================
         BOTÓN PARA CAMBIAR DE MANDO
         Siempre visible en la parte superior
    ========================================================= -->
    <Button
        android:id="@+id/btnCambiarMando"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_margin="12dp"
        android:text="Cambiar Mando"
        android:textAllCaps="false" />

    <!-- ========================================================
         MANDO 2 — Tres botones de colores
         Ocupa todo el espacio restante cuando está visible
    ========================================================= -->
    <LinearLayout
        android:id="@+id/contenedorMando2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1"
            android:layout_width="0dp"
            android:layout_height="250dp"
            android:layout_margin="5px"
            android:layout_weight="1"
            android:text=""
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textSize="24sp"
            android:textStyle="bold"
            app:backgroundTint="#FFEB3B"
            app:cornerRadius="250dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn2"
            android:layout_width="0dp"
            android:layout_height="250dp"
            android:layout_margin="5px"
            android:layout_weight="1"
            android:text=""
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textSize="24sp"
            android:textStyle="bold"
            app:backgroundTint="#B6B6B6"
            app:cornerRadius="260dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn3"
            android:layout_width="0dp"
            android:layout_height="250dp"
            android:layout_margin="5px"
            android:layout_weight="1"
            android:text=""
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textSize="24sp"
            android:textStyle="bold"
            app:backgroundTint="#B6B6B6"
            app:cornerRadius="260dp" />

    </LinearLayout>

    <!-- ========================================================
         MANDO 3 — Giroscopio + imagen + canción
         Empieza oculto, se muestra al cambiar de mando
    ========================================================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contenedorMando3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imagen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:rotation="90"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/pistola" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>